AWS_REGION=us-east-1
AWS_ACCOUNT_ID=531728396479

PROJECT_NAME=moto-chatbot
ENVIRONMENT=dev

DB_HOST=
DB_PORT=5432
DB_NAME=moto_chatbot
DB_USER=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=6379

BEDROCK_REGION=us-east-1
LLM_MODEL=us.amazon.nova-lite-v1:0
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# LLM de chat (Groq) -- Bedrock queda disponible para casos atipicos
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Embeddings: proveedor conmutable (local = BGE-M3, bedrock = Titan)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

S3_BUCKET_NAME=moto-chatbot-manuales-531728396479

SQS_QUEUE_URL=

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_SIZE_TOKENS=20
TOP_K_RESULTS=5
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
MEMORY_TTL_SECONDS=1800

# Contextual Retrieval
CONTEXTUAL_RETRIEVAL_ENABLED=true
CONTEXT_MAX_DOC_CHARS=2000

# Reranking: proveedor conmutable (local = BGE reranker, bedrock = casos atipicos)
RERANKING_ENABLED=true
RERANK_PROVIDER=local
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Observabilidad (Langfuse Cloud) -- opcional, no bloqueante
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
